<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.FabCut" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#6C40F7</item>
        <item name="colorPrimaryVariant">#4A19D4</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#00E676</item>
        <item name="colorSecondaryVariant">#00B545</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor" tools:targetApi="l">#0F0F11</item>
        <item name="android:navigationBarColor" tools:targetApi="21">#1A1A1A</item>
        <item name="android:windowBackground">#0F0F11</item>
        <item name="colorSurface">#1A1A1A</item>
        <item name="colorOnSurface">#FFFFFF</item>
    </style>

    <style name="RoundedImage">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="CustomRatioChipStyle" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/chip_color_selector</item>
        <item name="chipStrokeColor">#55FFFFFF</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="android:textColor">@color/chip_text_color_selector</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="android:paddingHorizontal">12dp</item>
        <item name="android:paddingVertical">6dp</item>
        <item name="chipIconVisible">false</item>
        <item name="closeIconVisible">false</item>
        <item name="rippleColor">#336C40F7</item>
    </style>

</resources>